:root {
    --primary-orange: #ff6a00;
    --orange-dark: #e85f00;
    --background: #f7f8fa;
    --white: #ffffff;
    --text: #222222;
    --muted: #6b7280;
    --border: #e5e7eb;
    --danger: #dc2626;
    --success: #16a34a;
    --shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
    --radius: 12px;
}

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
}

body {
    background-color: var(--background);
    color: var(--text);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
}

/* Header Styles */
.reseller-header {
    background-color: var(--white);
    border-bottom: 1px solid var(--border);
    position: sticky;
    top: 0;
    z-index: 100;
}

.header-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 12px 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.brand-logo {
    height: 35px;
    object-fit: contain;
}

.back-btn {
    display: flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    color: var(--text);
    font-weight: 500;
    font-size: 14px;
    padding: 6px 12px;
    border-radius: 8px;
    border: 1px solid var(--border);
    transition: all 0.2s;
}

.back-btn:hover {
    background-color: var(--background);
    border-color: var(--primary-orange);
    color: var(--primary-orange);
}

/* Main Content */
.main-content {
    flex: 1;
    padding: 30px 15px;
}

.withdraw-wrapper {
    max-width: 600px;
    margin: 0 auto;
}

.page-title-box {
    text-align: center;
    margin-bottom: 25px;
}

.page-title-box h1 {
    font-size: 24px;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 6px;
}

.page-title-box p {
    font-size: 14px;
    color: var(--muted);
}

/* Cards & Panels */
.card, .withdraw-panel > div {
    background-color: var(--white);
    border-radius: var(--radius);
    border: 1px solid var(--border);
    box-shadow: var(--shadow);
    padding: 24px;
    margin-bottom: 20px;
}

.balance-card {
    background: linear-gradient(135deg, #ff6a00 0%, #e85f00 100%);
    color: var(--white);
    display: flex;
    justify-content: space-between;
    align-items: center;
    border: none;
}

.balance-label {
    font-size: 14px;
    opacity: 0.9;
}

.balance-card h2 {
    font-size: 32px;
    font-weight: 700;
    margin-top: 4px;
}

.balance-icon-box {
    background: rgba(255, 255, 255, 0.2);
    padding: 12px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
}

/* Form Styles */
.form-group {
    margin-bottom: 20px;
}

.form-group label {
    display: block;
    font-size: 14px;
    font-weight: 600;
    margin-bottom: 8px;
    color: var(--text);
}

.amount-display-box {
    background-color: var(--background);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 12px 16px;
    display: flex;
    flex-direction: column;
}

.amount-display-box span {
    font-size: 20px;
    font-weight: 700;
    color: var(--primary-orange);
}

.amount-display-box small {
    font-size: 12px;
    color: var(--muted);
    margin-top: 2px;
}

.input-with-icon {
    position: relative;
    display: flex;
    align-items: center;
}

.input-icon {
    position: absolute;
    left: 12px;
    color: var(--muted);
    display: flex;
    align-items: center;
}

.input-with-icon input {
    width: 100%;
    padding: 12px 16px 12px 42px;
    border: 1px solid var(--border);
    border-radius: 8px;
    font-size: 16px;
    outline: none;
    transition: border-color 0.2s;
}

.input-with-icon input:focus {
    border-color: var(--primary-orange);
}

.error-text {
    font-size: 12px;
    color: var(--danger);
    margin-top: 6px;
    display: block;
}

.primary-btn {
    width: 100%;
    background-color: var(--primary-orange);
    color: var(--white);
    border: none;
    border-radius: 8px;
    padding: 14px;
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    transition: background-color 0.2s;
}

.primary-btn:hover {
    background-color: var(--orange-dark);
}

.primary-btn:disabled {
    background-color: var(--muted);
    cursor: not-allowed;
}

/* States */
.state-card {
    text-align: center;
    padding: 40px 20px;
}

.state-icon-box {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    margin: 0 auto 16px;
    display: flex;
    align-items: center;
    justify-content: center;
}

.danger-bg {
    background-color: #fee2e2;
    color: var(--danger);
}

.success-bg {
    background-color: #dcfce7;
    color: var(--success);
}

.state-card h3 {
    font-size: 18px;
    font-weight: 600;
    margin-bottom: 8px;
}

.state-card p {
    font-size: 14px;
    color: var(--muted);
}

/* Spinner */
.spinner {
    width: 40px;
    height: 40px;
    border: 4px solid var(--border);
    border-top: 4px solid var(--primary-orange);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
    margin: 0 auto 16px;
}

@keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
}

/* Custom Popup Modal */
.popup-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.5);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1000;
    padding: 20px;
}

.popup-box {
    background: var(--white);
    padding: 30px;
    border-radius: var(--radius);
    max-width: 400px;
    width: 100%;
    text-align: center;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2);
}

.popup-icon {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    margin: 0 auto 15px;
    display: flex;
    align-items: center;
    justify-content: center;
}

.popup-box h3 {
    font-size: 18px;
    margin-bottom: 10px;
}

.popup-box p {
    font-size: 14px;
    color: var(--muted);
    margin-bottom: 20px;
}

/* Utility */
.hidden {
    display: none !important;
}

.icon {
    width: 20px;
    height: 20px;
}

.icon-large {
    width: 28px;
    height: 28px;
}

.icon-xl {
    width: 32px;
    height: 32px;
}
